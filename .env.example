# ══════════════════════════════════════════════════════════════════════════════
# Télémédecine Sécurisée — Variables d'environnement
# ══════════════════════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplissez les valeurs.
# IMPORTANT : Ne JAMAIS commiter le fichier .env dans le dépôt Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ────────────────────────────────────────────────
# Format : postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telemedecine

# ── Clé secrète de l'application ──────────────────────────────────────────────
# Utilisée pour signer les sessions et les tokens CSRF
# Générer avec : openssl rand -hex 64
SECRET_KEY=

# ── Configuration JWT (JSON Web Tokens) ──────────────────────────────────────
# Clé secrète pour signer les tokens JWT d'authentification
# Générer avec : openssl rand -hex 64
JWT_SECRET_KEY=

# Algorithme de signature JWT (HS256 recommandé pour HMAC-SHA256)
JWT_ALGORITHM=HS256

# Durée de validité des tokens JWT en minutes (30 min par défaut)
JWT_EXPIRATION_MINUTES=30

# ── Chiffrement des données sensibles (AES-256-GCM) ─────────────────────────
# Clé de chiffrement AES-256 encodée en base64 (32 bytes)
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=

# ── CORS — Origines autorisées ───────────────────────────────────────────────
# Liste des origines autorisées, séparées par des virgules
# Ex : https://app.telemedecine.fr,https://admin.telemedecine.fr
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Niveau de log : DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Environnement ───────────────────────────────────────────────────────────
# Valeurs possibles : development, staging, production
ENVIRONMENT=development

# ── Sentry — Suivi des erreurs en production ─────────────────────────────────
# DSN Sentry pour le reporting d'erreurs (laisser vide en développement)
SENTRY_DSN=

# ── Redis — Cache et sessions ────────────────────────────────────────────────
# URL de connexion Redis
# Format : redis://[:password]@host:port/db_number
REDIS_URL=redis://localhost:6379/0
