# ══════════════════════════════════════════════════════════════════════════════
# Télémédecine Sécurisée — Dockerfile.test
# ══════════════════════════════════════════════════════════════════════════════
# Build : docker build -f docker/Dockerfile.test -t telemedecine-test .
# Run   : docker run telemedecine-test
# ══════════════════════════════════════════════════════════════════════════════

FROM python:3.12-slim

LABEL org.opencontainers.image.title="telemedecine-securisee-test"
LABEL org.opencontainers.image.description="Image de test pour la plateforme de télémédecine sécurisée"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ENVIRONMENT=testing

WORKDIR /app

# Installer les dépendances système
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copier et installer les dépendances
COPY requirements/base.txt requirements/base.txt
COPY requirements/test.txt requirements/test.txt
RUN pip install --no-warn-script-location -r requirements/test.txt

# Copier le code source et les tests
COPY src/ /app/src/
COPY tests/ /app/tests/
COPY pyproject.toml /app/pyproject.toml

ENV PYTHONPATH=/app/src

# Lancer pytest avec couverture
CMD ["python", "-m", "pytest", "tests/", \
     "-v", \
     "--tb=short", \
     "--cov=src/app", \
     "--cov-report=term-missing", \
     "--cov-report=xml:coverage.xml", \
     "--junitxml=test-results.xml"]
