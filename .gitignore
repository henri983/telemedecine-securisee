# ══════════════════════════════════════════════════════════════════════════════
# Télémédecine Sécurisée — .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ── Distribution / Packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
*.whl
sdist/
wheels/
pip-wheel-metadata/

# ── Environnements virtuels ──────────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Variables d'environnement et secrets ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# ── Tests et couverture ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ── IDE et éditeurs ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Bases de données locales ─────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Node (si frontend intégré) ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Terraform / Infrastructure ───────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Jupyter Notebooks (checkpoints) ──────────────────────────────────────────
.ipynb_checkpoints/

# ── Cache divers ─────────────────────────────────────────────────────────────
.cache/
.ruff_cache/
.bandit/
